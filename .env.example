# ==============================================================================
# SeismoFNO Application Layer Environment Configuration
# ==============================================================================

# Backend Gateway Port and Binding
PORT=8000
HOST=0.0.0.0

# Compute Device Target
# Options: 'mps' (Apple Silicon GPU), 'cuda' (NVIDIA GPU), 'cpu' (Standard CPU)
# Recommended: 'mps' for local macOS workstations, 'cpu' for standard cloud containers
DEVICE=cpu

# Forces stdout/stderr flush for immediate real-time logging
PYTHONUNBUFFERED=1

# Frontend API Target (Vite development and production client API base URL)
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Optional AI Copilot Configuration (seismo_agent)
# ------------------------------------------------------------------------------
# If unset or empty, the copilot automatically falls back to an offline,
# deterministic rule-based civil engineering advisor engine. No key required for demo.
# NEBIUS_API_KEY=your_optional_nebius_api_key_here
